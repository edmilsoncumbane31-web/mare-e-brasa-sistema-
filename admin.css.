
:root {
    --azul: #101b2d;
    --azul-claro: #1b2b43;
    --dourado: #c69b55;
    --creme: #f7f4ed;
    --branco: #ffffff;
    --texto: #263247;
    --cinza: #78818e;
    --borda: #e5e1d8;
    --verde: #25845b;
    --vermelho: #bd4545;
    --sombra: 0 5px 20px rgba(16, 27, 45, 0.07);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    background: var(--creme);
    color: var(--texto);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.5;
}

[hidden] {
    display: none !important;
}

/* CABEÇALHO */

.topo {
    background: var(--azul);
    color: var(--branco);
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    border-bottom: 3px solid var(--dourado);
}

.topo h1 {
    font-size: 22px;
    letter-spacing: 0.5px;
}

.topo p {
    color: #d5d9df;
    font-size: 13px;
}

button {
    border: none;
    border-radius: 8px;
    padding: 11px 16px;
    background: var(--dourado);
    color: var(--azul);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
}

button:hover {
    opacity: 0.9;
}

button:active {
    transform: scale(0.98);
}

button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

#btn-sair {
    background: transparent;
    color: var(--branco);
    border: 1px solid var(--dourado);
}

/* CONTEÚDO */

main {
    width: 100%;
    max-width: 1150px;
    margin: 25px auto;
    padding: 0 18px;
}

h2 {
    color: var(--azul);
    font-size: 21px;
    margin-bottom: 12px;
}

p {
    margin-bottom: 8px;
}

/* LOGIN */

.painel {
    max-width: 430px;
    margin: 45px auto;
    padding: 28px;
    background: var(--branco);
    border-radius: 14px;
    box-shadow: var(--sombra);
    border-top: 4px solid var(--dourado);
}

.painel h2 {
    text-align: center;
}

.painel > p {
    text-align: center;
    color: var(--cinza);
    font-size: 14px;
    margin-bottom: 22px;
}

form {
    display: flex;
    flex-direction: column;
    gap: 9px;
}

label {
    font-size: 13px;
    font-weight: 700;
    color: var(--azul);
}

input,
select,
textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--borda);
    border-radius: 8px;
    background: var(--branco);
    color: var(--texto);
    font-family: inherit;
    font-size: 14px;
    outline: none;
}

input:focus,
select:focus,
textarea:focus {
    border-color: var(--dourado);
    box-shadow: 0 0 0 2px rgba(198, 155, 85, 0.13);
}

#form-login button {
    margin-top: 12px;
}

#mensagem-login {
    margin-top: 8px;
    font-size: 13px;
}

/* INDICADORES */

.resumo {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin: 22px 0;
}

.cartao {
    background: var(--branco);
    padding: 20px;
    border-radius: 12px;
    box-shadow: var(--sombra);
    border-left: 4px solid var(--dourado);
}

.cartao span {
    display: block;
    color: var(--cinza);
    font-size: 13px;
}

.cartao strong {
    display: block;
    color: var(--azul);
    font-size: 29px;
    margin-top: 5px;
}

/* NAVEGAÇÃO */

.navegacao {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 25px 0;
}

.nav-btn {
    background: var(--branco);
    color: var(--azul);
    border: 1px solid var(--borda);
}

.nav-btn.ativo,
.nav-btn[aria-current="page"] {
    background: var(--azul);
    color: var(--branco);
    border-color: var(--azul);
}

/* SECÇÕES */

.secao {
    background: var(--branco);
    padding: 22px;
    margin: 20px 0;
    border-radius: 12px;
    box-shadow: var(--sombra);
}

.secao h2 {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--borda);
}

/* FILTROS E FERRAMENTAS */

.ferramentas {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 15px 0;
}

.ferramentas select {
    max-width: 230px;
}

/* LISTAS E ELEMENTOS */

#lista-pedidos,
#gestao-cardapio,
#lista-mesas,
#lista-equipa,
#lista-historico {
    display: grid;
    gap: 13px;
    margin-top: 15px;
}

.pedido,
.item-gestao,
.mesa,
.membro,
.registo,
.cartao-pedido {
    background: #fcfbf8;
    border: 1px solid var(--borda);
    border-radius: 10px;
    padding: 16px;
}

.pedido h3,
.item-gestao h3,
.mesa h3,
.membro h3 {
    color: var(--azul);
    font-size: 16px;
    margin-bottom: 7px;
}

.pedido p,
.item-gestao p,
.mesa p,
.membro p,
.registo p {
    color: var(--cinza);
    font-size: 13px;
    margin-bottom: 5px;
}

.acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 13px;
}

.botao-secundario {
    background: var(--azul);
    color: var(--branco);
}

.botao-perigo {
    background: var(--vermelho);
    color: var(--branco);
}

.botao-sucesso {
    background: var(--verde);
    color: var(--branco);
}

.estado {
    display: inline-block;
    padding: 4px 9px;
    border-radius: 20px;
    background: #eee8dc;
    color: var(--azul);
    font-size: 11px;
    font-weight: 700;
    margin: 5px 5px 5px 0;
}

.vazio,
.mensagem {
    padding: 18px;
    text-align: center;
    color: var(--cinza);
    background: #fcfbf8;
    border-radius: 8px;
    font-size: 14px;
}

/* RODAPÉ */

footer {
    padding: 20px;
    margin-top: 40px;
    background: var(--azul);
    color: #d5d9df;
    text-align: center;
    font-size: 12px;
}

/* TELEMÓVEIS */

@media (max-width: 650px) {
    .topo {
        padding: 16px;
    }

    .topo h1 {
        font-size: 19px;
    }

    .topo button {
        padding: 9px 10px;
        font-size: 12px;
    }

    main {
        margin: 18px auto;
        padding: 0 12px;
    }

    .resumo {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .cartao {
        padding: 14px;
    }

    .cartao strong {
        font-size: 24px;
    }

    .navegacao {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
    }

    .nav-btn {
        width: 100%;
        padding: 12px 6px;
        font-size: 12px;
    }

    .secao {
        padding: 15px;
    }

    .painel {
        margin: 25px auto;
        padding: 20px;
    }

    .ferramentas {
        flex-direction: column;
        align-items: stretch;
    }

    .ferramentas select,
    .ferramentas button {
        max-width: none;
        width: 100%;
    }

    .acoes button {
        flex: 1 1 100%;
    }
}
